# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Prisma-installed AI agent skill references (local tooling, not app code)
/.claude/skills/prisma-*
/.agents/skills/prisma-*
/.windsurf/skills/prisma-*
/skills-lock.json
dev-server.log

# Copied from node_modules by scripts/copy-zxing-wasm.mjs at build time
/public/zxing_reader.wasm
