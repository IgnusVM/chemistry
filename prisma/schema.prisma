// Chemistry — asset management for Alchemy. Phase 1 schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DepartmentRole {
  VIEWER
  MEMBER
  LEAD
}

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  STORAGE
  RETIRED
  LOST
  DESTROYED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  UNSERVICEABLE
}

enum LocationType {
  STORAGE_FACILITY
  CONTAINER
  ZONE
  CAMP
  PLACEMENT
  VEHICLE
}

enum WorkOrderType {
  CORRECTIVE
  PREVENTIVE
  INSPECTION
  MODIFICATION
  DECOMMISSION
  GENERAL
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  EVENT_CRITICAL
}

/// The sub-statuses a work order moves through. The parent status (Open or
/// Closed) is derived from these rather than stored: COMPLETE and CANCELLED are
/// the two ways a ticket ends, everything else means it is still open. Storing
/// both would be two records that have to agree, and eventually would not.
enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_PARTS
  COMPLETE
  CANCELLED
}

model Division {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  leadUserId  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead        User?        @relation("DivisionLead", fields: [leadUserId], references: [id])
  departments Department[]
  board       Board?
}

model Department {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  leadUserId  String?
  divisionId  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead        User?                  @relation("DepartmentLead", fields: [leadUserId], references: [id])
  division    Division?              @relation(fields: [divisionId], references: [id])
  memberships DepartmentMembership[]
  assetTypes  AssetType[]
  assets      Asset[]
  workOrders  WorkOrder[]
  loanPrivileges AssetLoanPrivilege[]
  board          Board?
}

/// Grants one user the right to check assets in and out for one department.
/// Deliberately NOT a flag on DepartmentMembership: a department lead can hand
/// this to someone who isn't a member of their department (e.g. a Lamplighter
/// borrowing APW tools), and that shouldn't silently make them a member.
model AssetLoanPrivilege {
  id              String   @id @default(cuid())
  userId          String
  departmentId    String
  grantedByUserId String?
  createdAt       DateTime @default(now())

  user       User       @relation("LoanPrivilegeUser", fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("LoanPrivilegeGrantedBy", fields: [grantedByUserId], references: [id])

  @@unique([userId, departmentId])
  @@index([departmentId])
}

/// Append-only loan log. An open loan is a row with checkedInAt = null; a
/// partial unique index (see the migration) enforces at most one of those per
/// asset, so the same tool can't be checked out twice.
model AssetLoan {
  id                 String    @id @default(cuid())
  assetId            String
  // Nullable so deleting a user doesn't hit an FK wall — the log survives with
  // an "Unknown" borrower, matching every other User relation here. deleteUser
  // separately refuses while the user still has anything checked out.
  borrowerUserId     String?
  checkedOutByUserId String?
  checkedOutAt       DateTime  @default(now())
  checkedOutNotes    String?
  checkedInAt        DateTime?
  checkedInByUserId  String?
  checkedInNotes     String?

  asset        Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  borrower     User? @relation("LoanBorrower", fields: [borrowerUserId], references: [id])
  checkedOutBy User? @relation("LoanCheckedOutBy", fields: [checkedOutByUserId], references: [id])
  checkedInBy  User? @relation("LoanCheckedInBy", fields: [checkedInByUserId], references: [id])

  @@index([assetId])
  @@index([borrowerUserId])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  displayName    String    @unique
  name           String?
  phone          String?
  notifyByEmail  Boolean   @default(false)
  contactDuringBurnCell  Boolean @default(false)
  contactDuringBurnEmail Boolean @default(false)
  contactDuringBurnOther String?
  isOrgAdmin     Boolean   @default(false)
  /// Director: every permission an org admin has, and then some. Kept as a
  /// separate flag rather than a rank on isOrgAdmin so that revoking one
  /// cannot silently revoke the other. Only the root Director (identified by
  /// ROOT_DIRECTOR_EMAIL) may grant or revoke it.
  isDirector     Boolean   @default(false)
  avatarS3Key    String?
  badgeIcon      String?
  badgeColor     String?
  pinHash        String?
  pinFailedCount Int       @default(0)
  pinLockedUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships       DepartmentMembership[]
  ledDepartments    Department[]            @relation("DepartmentLead")
  ledDivisions      Division[]              @relation("DivisionLead")
  ownedCards        Card[]                  @relation("CardOwner")
  createdCards      Card[]                  @relation("CardCreatedBy")
  createdAssets     Asset[]                 @relation("AssetCreatedBy")
  locationMoves     AssetLocationHistory[]
  magicLinkTokens   MagicLinkToken[]
  trustedDevices    TrustedDevice[]
  auditLogs         AuditLog[]
  reportedWorkOrders  WorkOrder[]           @relation("WorkOrderReportedBy")
  assignedWorkOrders  WorkOrder[]           @relation("WorkOrderAssignedTo")
  workOrderNotes      WorkOrderNote[]
  workOrderAttachments WorkOrderAttachment[]
  assetTypeDocuments  AssetTypeDocument[]
  createdInvites      InviteCode[]          @relation("InviteCreatedBy")
  redeemedInvites     InviteCode[]          @relation("InviteUsedBy")
  partOrders          PartOrder[]
  partLinks           PartLink[]
  workOrderParts      WorkOrderPart[]
  bulkSelections      BulkSelection[]
  assetNotes          AssetNote[]
  assetCodeFiles      AssetCodeFile[]
  assetCodeFileVersions AssetCodeFileVersion[]
  loanPrivileges      AssetLoanPrivilege[]   @relation("LoanPrivilegeUser")
  loanPrivilegesGranted AssetLoanPrivilege[] @relation("LoanPrivilegeGrantedBy")
  borrowedLoans       AssetLoan[]            @relation("LoanBorrower")
  loansCheckedOut     AssetLoan[]            @relation("LoanCheckedOutBy")
  loansCheckedIn      AssetLoan[]            @relation("LoanCheckedInBy")
  posts               Post[]
  personalBoard       Board?
  postReplies         PostReply[]
  workOrderRevisions  WorkOrderRevision[]
  completedTasks      WorkOrderTask[]
}

model InviteCode {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  createdByUserId String?
  expiresAt       DateTime
  usedAt          DateTime?
  usedByUserId    String?
  createdAt       DateTime  @default(now())

  createdBy User? @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])
  usedBy    User? @relation("InviteUsedBy", fields: [usedByUserId], references: [id])
}

model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  label      String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DepartmentMembership {
  id           String         @id @default(cuid())
  userId       String
  departmentId String
  role         DepartmentRole @default(MEMBER)
  createdAt    DateTime       @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id                String       @id @default(cuid())
  name              String
  type              LocationType
  parentLocationId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  parentLocation Location?               @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  children       Location[]              @relation("LocationHierarchy")
  assets         Asset[]
  history        AssetLocationHistory[]
}

model AssetType {
  id                  String   @id @default(cuid())
  name                String
  manufacturer        String?
  model               String?
  defaultDepartmentId String?
  defaultAcquisitionCost Decimal? @db.Decimal(10, 2)
  customFieldSchema   Json     @default("[]")
  // Opt-in: tools get checked in and out, deployed fleet assets don't. Off by
  // default so the Loans tab only appears where borrowing is a real concept.
  loanable            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  defaultDepartment Department? @relation(fields: [defaultDepartmentId], references: [id])
  assets            Asset[]
  documents         AssetTypeDocument[]
  parts             Part[]
  codeFiles         AssetCodeFile[]
}

model Part {
  id          String   @id @default(cuid())
  assetTypeId String
  partNumber  String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assetType     AssetType       @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  orders        PartOrder[]
  links         PartLink[]
  workOrderUses WorkOrderPart[]

  @@unique([assetTypeId, partNumber])
}

model PartOrder {
  id              String   @id @default(cuid())
  partId          String
  price           Decimal? @db.Decimal(10, 2)
  quantity        Int      @default(1)
  orderedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  createdByUserId String?

  part      Part  @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id])

  @@index([partId])
}

// A reference purchase link for a part — where to get it and roughly what
// it costs — kept separate from PartOrder, which instead tracks a specific
// purchase event (price/quantity actually bought, no link).
model PartLink {
  id              String   @id @default(cuid())
  partId          String
  url             String
  price           Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  createdByUserId String?

  part      Part  @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id])

  @@index([partId])
}

model WorkOrderPart {
  id              String   @id @default(cuid())
  workOrderId     String
  partId          String
  quantity        Int      @default(1)
  createdAt       DateTime @default(now())
  createdByUserId String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part      Part      @relation(fields: [partId], references: [id])
  createdBy User?     @relation(fields: [createdByUserId], references: [id])

  @@index([workOrderId])
  @@index([partId])
}

model AssetTypeDocument {
  id               String   @id @default(cuid())
  assetTypeId      String
  s3Key            String
  filename         String
  mimeType         String
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  assetType  AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedByUserId], references: [id])

  @@index([assetTypeId])
}

model Asset {
  id                 String          @id @default(cuid())
  assetTag           String          @unique
  name               String
  description        String?
  assetTypeId        String
  owningDepartmentId String
  status             AssetStatus     @default(ACTIVE)
  condition          AssetCondition  @default(GOOD)
  acquisitionDate    DateTime?
  acquisitionCost    Decimal?        @db.Decimal(10, 2)
  parentAssetId      String?
  currentLocationId  String?
  customLocationText String?
  customFields       Json            @default("{}")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdByUserId    String?

  assetType        AssetType          @relation(fields: [assetTypeId], references: [id])
  owningDepartment Department         @relation(fields: [owningDepartmentId], references: [id])
  parentAsset      Asset?             @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  childAssets      Asset[]            @relation("AssetHierarchy")
  currentLocation  Location?          @relation(fields: [currentLocationId], references: [id])
  createdBy        User?              @relation("AssetCreatedBy", fields: [createdByUserId], references: [id])
  groupMemberships AssetGroupMember[]
  locationHistory  AssetLocationHistory[]
  workOrders       WorkOrder[]
  notes            AssetNote[]
  loans            AssetLoan[]

  @@index([owningDepartmentId])
  @@index([assetTypeId])
  @@index([status])
}

model AssetGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  members AssetGroupMember[]
}

model AssetGroupMember {
  assetGroupId String
  assetId      String
  addedAt      DateTime @default(now())

  assetGroup AssetGroup @relation(fields: [assetGroupId], references: [id], onDelete: Cascade)
  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetGroupId, assetId])
}

model AssetLocationHistory {
  id                 String   @id @default(cuid())
  assetId            String
  locationId         String?
  customLocationText String?
  movedAt            DateTime @default(now())
  movedByUserId      String?
  notes              String?

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])
  movedBy  User?     @relation(fields: [movedByUserId], references: [id])

  @@index([assetId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  changes    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ResolutionCode {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  createdAt DateTime @default(now())

  workOrders WorkOrder[]
}

model WorkOrder {
  id               String            @id @default(cuid())
  code             String            @unique
  assetId          String?
  departmentId     String
  type             WorkOrderType     @default(CORRECTIVE)
  priority         WorkOrderPriority @default(NORMAL)
  status           WorkOrderStatus   @default(PENDING)
  /// Short summary, shown in every list. Backfilled from `description`,
  /// which used to serve as both.
  title            String   @default("")
  /// The long account of the problem. Separate from the title so a list stays
  /// scannable while the ticket itself can hold as much detail as it needs.
  description      String
  reportedByUserId String?
  assignedToUserId String?
  reportedAt       DateTime          @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  closedAt         DateTime?
  resolutionCodeId String?
  resolutionNotes  String?
  laborMinutes     Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  asset          Asset?                @relation(fields: [assetId], references: [id])
  department     Department            @relation(fields: [departmentId], references: [id])
  reportedBy     User?                 @relation("WorkOrderReportedBy", fields: [reportedByUserId], references: [id])
  assignedTo     User?                 @relation("WorkOrderAssignedTo", fields: [assignedToUserId], references: [id])
  resolutionCode ResolutionCode?       @relation(fields: [resolutionCodeId], references: [id])
  notes          WorkOrderNote[]
  attachments    WorkOrderAttachment[]
  partsUsed      WorkOrderPart[]
  card           Card?
  referencedBy   CardWorkOrderRef[]
  codeFileVersions AssetCodeFileVersion[]
  revisions        WorkOrderRevision[]
  tasks            WorkOrderTask[]

  @@index([departmentId])
  @@index([status])
  @@index([assetId])
}

enum NoteFormat {
  HTML
  MARKDOWN
}

model WorkOrderNote {
  id          String     @id @default(cuid())
  workOrderId String
  userId      String?
  body        String
  format      NoteFormat @default(HTML)
  createdAt   DateTime   @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([workOrderId])
}

model AssetNote {
  id        String     @id @default(cuid())
  assetId   String
  userId    String?
  body      String
  format    NoteFormat @default(HTML)
  createdAt DateTime   @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([assetId])
}

/// Source that runs on a class of machine (a lantern's charging logic, say),
/// so it lives on the AssetType rather than on each unit — 300 lanterns run one
/// program, and a fix belongs to the design, not to the one unit it was found
/// on. Which firmware a specific unit is actually flashed with is tracked
/// separately as an ordinary custom field, not by this model.
model AssetCodeFile {
  id              String   @id @default(cuid())
  assetTypeId     String
  filename        String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  assetType AssetType              @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  createdBy User?                  @relation(fields: [createdByUserId], references: [id])
  versions  AssetCodeFileVersion[]

  @@unique([assetTypeId, filename])
  @@index([assetTypeId])
}

model AssetCodeFileVersion {
  id              String   @id @default(cuid())
  codeFileId      String
  content         String
  message         String?
  createdAt       DateTime @default(now())
  createdByUserId String?
  workOrderId     String?

  codeFile  AssetCodeFile @relation(fields: [codeFileId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdByUserId], references: [id])
  workOrder WorkOrder?    @relation(fields: [workOrderId], references: [id])

  @@index([codeFileId])
  @@index([workOrderId])
}

model HelpArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  summary   String?
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model WorkOrderAttachment {
  id               String   @id @default(cuid())
  workOrderId      String
  s3Key            String
  filename         String
  mimeType         String
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedByUserId], references: [id])

  @@index([workOrderId])
}

// Short-lived handoff of a multi-select list's resolved row IDs from a list
// page (assets/work orders) to a dedicated bulk-action page, so the URL
// never has to carry a large id list. Created, read once, then irrelevant —
// not cleaned up proactively (small rows, 15-min expiry, checked on read).
model BulkSelection {
  id              String   @id @default(cuid())
  entityType      String
  ids             Json
  createdByUserId String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([createdByUserId])
}

// ---------------------------------------------------------------------------
// Task board
//
// One board per department, created implicitly by the seed so nobody ever has
// to meet the concept of "making a board".
//
// The load-bearing decision: a work-order-backed card does NOT store its
// column. Card.columnId is NULL for those, and the column is derived from
// workOrder.status at read time via BoardColumn.woStatusesShown. Card position
// and work order status therefore cannot disagree, because there is only one
// piece of state rather than two kept in step.
// See specs/001-kanban-board/research.md D1.
// ---------------------------------------------------------------------------

// A board belongs to EITHER a department or a division, never both and never
// neither. Prisma cannot express "exactly one of these two is set", so a CHECK
// constraint is hand-written into the migration -- see
// Board_owner_exactly_one in the task-board-division migration.
//
// Division boards differ from department boards in two ways that matter:
//   - they are visible only to the division lead and org admins (the app's
//     first restricted read -- see constitution Principle II)
//   - they get no auto-created work order cards; a ticket appears on one only
//     when a user attaches it to a card deliberately
model Board {
  id           String   @id @default(cuid())
  departmentId String?  @unique
  divisionId   String?  @unique
  /// A personal kanban, owned by and visible to exactly one person. The third
  /// owner kind; Board_owner_exactly_one keeps it to one of the three.
  userId       String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  division   Division?     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns    BoardColumn[]
  cards      Card[]
}

model BoardColumn {
  id       String  @id @default(cuid())
  boardId  String
  name     String
  position Int
  color    String?

  // Moving a work-order-backed card here sets this status. NULL means the
  // column refuses work-order cards at all (Ideas/Backlog, by default).
  woStatusOnMove  WorkOrderStatus?
  // Which work order statuses render in this column. Board invariant, enforced
  // in src/lib/board.ts: every status appears in exactly one column, so a card
  // can be neither invisible nor duplicated.
  woStatusesShown WorkOrderStatus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
}

model Card {
  id       String  @id @default(cuid())
  boardId  String
  // NULL for work-order-backed cards -- their column is derived, not stored.
  columnId String?

  title       String
  ownerUserId String?
  nextAction  String?
  dueDate     DateTime?
  statusNotes String?
  position    Int       @default(0)

  // Nullable unique: Postgres permits many NULLs in a unique index, so this
  // means "at most one card per work order, unlimited standalone cards".
  // No partial index required.
  workOrderId String? @unique

  archivedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // Restrict is what makes "deleting a column requires saying where its cards
  // go" enforceable at the database, rather than by hoping the action did it.
  column    BoardColumn? @relation(fields: [columnId], references: [id], onDelete: Restrict)
  owner     User?        @relation("CardOwner", fields: [ownerUserId], references: [id])
  createdBy User?        @relation("CardCreatedBy", fields: [createdByUserId], references: [id])
  workOrder WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  tags      CardTag[]
  refs      CardWorkOrderRef[]

  @@index([boardId, columnId, position])
  @@index([ownerUserId])
}

// Organization-wide, so a team tag means the same thing on every board.
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  cards CardTag[]
}

model CardTag {
  cardId String
  tagId  String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@index([tagId])
}

// A card REFERENCING a work order, as context. Deliberately separate from
// Card.workOrderId, which means the card IS that work order.
//
//   Card.workOrderId  -> the card is the work order's representation. Auto
//                        created, column derived from status, cannot be moved
//                        to an unmapped column, dies with the work order.
//   CardWorkOrderRef  -> the card is its own thing and merely points at one or
//                        more tickets. Stays standalone, moves freely, and
//                        losing the reference does not touch the card.
//
// Division boards use this exclusively: they auto-create nothing, so a ticket
// appears there only when someone attaches it deliberately.
model CardWorkOrderRef {
  cardId      String
  workOrderId String
  createdAt   DateTime @default(now())

  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@id([cardId, workOrderId])
  @@index([workOrderId])
}

/// A noticeboard post. Only org admins write these; everyone reads them.
/// Rich content (images, link previews) lives in the two child tables rather
/// than as columns, because a post has zero or many of each.
model Post {
  id           String   @id @default(cuid())
  authorUserId String?
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author  User?       @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  images  PostImage[]
  links   PostLink[]
  replies PostReply[]

  /// The feed reads newest-first and pages by this.
  @@index([createdAt])
}

/// An uploaded image on a post. Deliberately NOT rendered until asked for:
/// the feed shows a placeholder and fetches a presigned URL on demand, so
/// scrolling past a hundred posts costs nothing in object storage.
model PostImage {
  id       String @id @default(cuid())
  postId   String
  s3Key    String
  filename String
  mimeType String
  position Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// A link with the preview metadata captured when the post was written.
/// Stored rather than re-fetched so the feed never makes outbound requests
/// while someone scrolls, and so a preview cannot change under a reader.
model PostLink {
  id          String  @id @default(cuid())
  postId      String
  url         String
  title       String?
  description String?
  imageUrl    String?
  siteName    String?
  position    Int     @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// A reply. Any signed-in member may write one, and it is TEXT ONLY -- no
/// images, no links expanded -- which keeps both the moderation surface and
/// the storage cost to what a sentence can carry.
model PostReply {
  id           String   @id @default(cuid())
  postId       String
  authorUserId String?
  body         String
  createdAt    DateTime @default(now())

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
}

/// One edit to a work order, kept so it can be undone.
///
/// Stores the fields that changed and both sides of the change, rather than a
/// whole snapshot: an undo has to put back exactly what the edit touched and
/// leave everything else alone, or two people editing different fields would
/// have one silently reverting the other's work.
model WorkOrderRevision {
  id            String   @id @default(cuid())
  workOrderId   String
  editedByUserId String?
  /// Field name -> value before this edit.
  before        Json
  /// Field name -> value after it.
  after         Json
  /// Undone edits stay in place so they can be redone; they are skipped when
  /// looking for the next thing to undo.
  undone        Boolean  @default(false)
  createdAt     DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  editedBy  User?     @relation(fields: [editedByUserId], references: [id], onDelete: SetNull)

  @@index([workOrderId, createdAt])
}

/// A checkbox on a work order: one small thing that has to happen before the
/// ticket is finished.
///
/// Short by design (50 characters). These are a checklist, not a place to
/// describe the problem -- that is what the description is for -- and a long
/// one stops being scannable, which is the only reason to have checkboxes at
/// all.
model WorkOrderTask {
  id               String    @id @default(cuid())
  workOrderId      String
  text             String
  instructions     String?
  done             Boolean   @default(false)
  position         Int       @default(0)
  completedAt      DateTime?
  completedByUserId String?
  createdAt        DateTime  @default(now())

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  completedBy User?     @relation(fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([workOrderId, position])
}
