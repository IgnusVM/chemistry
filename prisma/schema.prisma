// Chemistry — asset management for Alchemy. Phase 1 schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DepartmentRole {
  VIEWER
  MEMBER
  LEAD
}

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  STORAGE
  RETIRED
  LOST
  DESTROYED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  UNSERVICEABLE
}

enum LocationType {
  STORAGE_FACILITY
  CONTAINER
  ZONE
  CAMP
  PLACEMENT
  VEHICLE
}

enum WorkOrderType {
  CORRECTIVE
  PREVENTIVE
  INSPECTION
  MODIFICATION
  DECOMMISSION
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  EVENT_CRITICAL
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  WAITING_PARTS
  COMPLETE
  CLOSED
  CANCELLED
}

model Division {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departments Department[]
}

model Department {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  leadUserId  String?
  divisionId  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead        User?                  @relation("DepartmentLead", fields: [leadUserId], references: [id])
  division    Division?              @relation(fields: [divisionId], references: [id])
  memberships DepartmentMembership[]
  assetTypes  AssetType[]
  assets      Asset[]
  workOrders  WorkOrder[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  displayName    String
  name           String?
  phone          String?
  notifyByEmail  Boolean   @default(false)
  contactDuringBurnCell  Boolean @default(false)
  contactDuringBurnEmail Boolean @default(false)
  contactDuringBurnOther String?
  isOrgAdmin     Boolean   @default(false)
  pinHash        String?
  pinFailedCount Int       @default(0)
  pinLockedUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships       DepartmentMembership[]
  ledDepartments    Department[]            @relation("DepartmentLead")
  createdAssets     Asset[]                 @relation("AssetCreatedBy")
  locationMoves     AssetLocationHistory[]
  magicLinkTokens   MagicLinkToken[]
  trustedDevices    TrustedDevice[]
  auditLogs         AuditLog[]
  reportedWorkOrders  WorkOrder[]           @relation("WorkOrderReportedBy")
  assignedWorkOrders  WorkOrder[]           @relation("WorkOrderAssignedTo")
  workOrderNotes      WorkOrderNote[]
  workOrderAttachments WorkOrderAttachment[]
  assetTypeDocuments  AssetTypeDocument[]
  createdInvites      InviteCode[]          @relation("InviteCreatedBy")
  redeemedInvites     InviteCode[]          @relation("InviteUsedBy")
  partOrders          PartOrder[]
  workOrderParts      WorkOrderPart[]
  bulkSelections      BulkSelection[]
  assetNotes          AssetNote[]
  assetCodeFiles      AssetCodeFile[]
  assetCodeFileVersions AssetCodeFileVersion[]
}

model InviteCode {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  createdByUserId String
  expiresAt       DateTime
  usedAt          DateTime?
  usedByUserId    String?
  createdAt       DateTime  @default(now())

  createdBy User  @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])
  usedBy    User? @relation("InviteUsedBy", fields: [usedByUserId], references: [id])
}

model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  label      String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DepartmentMembership {
  id           String         @id @default(cuid())
  userId       String
  departmentId String
  role         DepartmentRole @default(MEMBER)
  createdAt    DateTime       @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id                String       @id @default(cuid())
  name              String
  type              LocationType
  parentLocationId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  parentLocation Location?               @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  children       Location[]              @relation("LocationHierarchy")
  assets         Asset[]
  history        AssetLocationHistory[]
}

model AssetType {
  id                  String   @id @default(cuid())
  name                String
  manufacturer        String?
  model               String?
  defaultDepartmentId String?
  defaultAcquisitionCost Decimal? @db.Decimal(10, 2)
  customFieldSchema   Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  defaultDepartment Department? @relation(fields: [defaultDepartmentId], references: [id])
  assets            Asset[]
  documents         AssetTypeDocument[]
  parts             Part[]
}

model Part {
  id          String   @id @default(cuid())
  assetTypeId String
  partNumber  String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assetType     AssetType       @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  orders        PartOrder[]
  workOrderUses WorkOrderPart[]

  @@unique([assetTypeId, partNumber])
}

model PartOrder {
  id              String   @id @default(cuid())
  partId          String
  price           Decimal? @db.Decimal(10, 2)
  purchaseLink    String?
  orderedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  createdByUserId String?

  part      Part  @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id])

  @@index([partId])
}

model WorkOrderPart {
  id              String   @id @default(cuid())
  workOrderId     String
  partId          String
  quantity        Int      @default(1)
  createdAt       DateTime @default(now())
  createdByUserId String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part      Part      @relation(fields: [partId], references: [id])
  createdBy User?     @relation(fields: [createdByUserId], references: [id])

  @@index([workOrderId])
  @@index([partId])
}

model AssetTypeDocument {
  id               String   @id @default(cuid())
  assetTypeId      String
  s3Key            String
  filename         String
  mimeType         String
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  assetType  AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedByUserId], references: [id])

  @@index([assetTypeId])
}

model Asset {
  id                 String          @id @default(cuid())
  assetTag           String          @unique
  name               String
  description        String?
  assetTypeId        String
  owningDepartmentId String
  status             AssetStatus     @default(ACTIVE)
  condition          AssetCondition  @default(GOOD)
  acquisitionDate    DateTime?
  acquisitionCost    Decimal?        @db.Decimal(10, 2)
  parentAssetId      String?
  currentLocationId  String?
  customLocationText String?
  customFields       Json            @default("{}")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdByUserId    String?

  assetType        AssetType          @relation(fields: [assetTypeId], references: [id])
  owningDepartment Department         @relation(fields: [owningDepartmentId], references: [id])
  parentAsset      Asset?             @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  childAssets      Asset[]            @relation("AssetHierarchy")
  currentLocation  Location?          @relation(fields: [currentLocationId], references: [id])
  createdBy        User?              @relation("AssetCreatedBy", fields: [createdByUserId], references: [id])
  groupMemberships AssetGroupMember[]
  locationHistory  AssetLocationHistory[]
  workOrders       WorkOrder[]
  notes            AssetNote[]
  codeFiles        AssetCodeFile[]

  @@index([owningDepartmentId])
  @@index([assetTypeId])
  @@index([status])
}

model AssetGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  members AssetGroupMember[]
}

model AssetGroupMember {
  assetGroupId String
  assetId      String
  addedAt      DateTime @default(now())

  assetGroup AssetGroup @relation(fields: [assetGroupId], references: [id], onDelete: Cascade)
  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetGroupId, assetId])
}

model AssetLocationHistory {
  id                 String   @id @default(cuid())
  assetId            String
  locationId         String?
  customLocationText String?
  movedAt            DateTime @default(now())
  movedByUserId      String?
  notes              String?

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])
  movedBy  User?     @relation(fields: [movedByUserId], references: [id])

  @@index([assetId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  changes    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ResolutionCode {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  createdAt DateTime @default(now())

  workOrders WorkOrder[]
}

model WorkOrder {
  id               String            @id @default(cuid())
  code             String            @unique
  assetId          String?
  departmentId     String
  type             WorkOrderType     @default(CORRECTIVE)
  priority         WorkOrderPriority @default(NORMAL)
  status           WorkOrderStatus   @default(OPEN)
  description      String
  reportedByUserId String?
  assignedToUserId String?
  reportedAt       DateTime          @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  closedAt         DateTime?
  resolutionCodeId String?
  resolutionNotes  String?
  laborMinutes     Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  asset          Asset?                @relation(fields: [assetId], references: [id])
  department     Department            @relation(fields: [departmentId], references: [id])
  reportedBy     User?                 @relation("WorkOrderReportedBy", fields: [reportedByUserId], references: [id])
  assignedTo     User?                 @relation("WorkOrderAssignedTo", fields: [assignedToUserId], references: [id])
  resolutionCode ResolutionCode?       @relation(fields: [resolutionCodeId], references: [id])
  notes          WorkOrderNote[]
  attachments    WorkOrderAttachment[]
  partsUsed      WorkOrderPart[]
  codeFileVersions AssetCodeFileVersion[]

  @@index([departmentId])
  @@index([status])
  @@index([assetId])
}

enum NoteFormat {
  HTML
  MARKDOWN
}

model WorkOrderNote {
  id          String     @id @default(cuid())
  workOrderId String
  userId      String?
  body        String
  format      NoteFormat @default(HTML)
  createdAt   DateTime   @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([workOrderId])
}

model AssetNote {
  id        String     @id @default(cuid())
  assetId   String
  userId    String?
  body      String
  format    NoteFormat @default(HTML)
  createdAt DateTime   @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([assetId])
}

model AssetCodeFile {
  id              String   @id @default(cuid())
  assetId         String
  filename        String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  asset     Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User?                  @relation(fields: [createdByUserId], references: [id])
  versions  AssetCodeFileVersion[]

  @@unique([assetId, filename])
  @@index([assetId])
}

model AssetCodeFileVersion {
  id              String   @id @default(cuid())
  codeFileId      String
  content         String
  message         String?
  createdAt       DateTime @default(now())
  createdByUserId String?
  workOrderId     String?

  codeFile  AssetCodeFile @relation(fields: [codeFileId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdByUserId], references: [id])
  workOrder WorkOrder?    @relation(fields: [workOrderId], references: [id])

  @@index([codeFileId])
  @@index([workOrderId])
}

model HelpArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  summary   String?
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model WorkOrderAttachment {
  id               String   @id @default(cuid())
  workOrderId      String
  s3Key            String
  filename         String
  mimeType         String
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedByUserId], references: [id])

  @@index([workOrderId])
}

// Short-lived handoff of a multi-select list's resolved row IDs from a list
// page (assets/work orders) to a dedicated bulk-action page, so the URL
// never has to carry a large id list. Created, read once, then irrelevant —
// not cleaned up proactively (small rows, 15-min expiry, checked on read).
model BulkSelection {
  id              String   @id @default(cuid())
  entityType      String
  ids             Json
  createdByUserId String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([createdByUserId])
}
