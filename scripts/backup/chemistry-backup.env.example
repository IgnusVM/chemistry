# Chemistry backup configuration.
#
# Copy to /etc/chemistry-backup.env on the server and `chmod 600` it.
# Nothing in the backup scripts is specific to any one AWS account, bucket, or
# operator — everything account-specific lives here, so handing the system to
# someone else is "replace this file", not "edit the scripts".

# --- Destination -------------------------------------------------------------
# Any S3-compatible store. Leave BACKUP_S3_ENDPOINT empty for AWS S3; set it to
# move to Backblaze B2, Cloudflare R2, MinIO, or similar without touching code.
BACKUP_S3_BUCKET=change-me
BACKUP_S3_PREFIX=chemistry-backups
BACKUP_S3_ENDPOINT=
AWS_DEFAULT_REGION=us-east-1

# --- Credentials -------------------------------------------------------------
# Use a DEDICATED identity with PutObject only — no DeleteObject.
# Deliberately NOT the application's own key: if backups can be deleted by the
# thing they're backing up, a compromise or a bad command takes both copies.
# Expiry is handled by a bucket lifecycle rule (see BACKUP.md), precisely so the
# writer never needs delete rights.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# --- Source ------------------------------------------------------------------
PG_CONTAINER=chemistry-postgres-1
PG_USER=chemistry
PG_DB=chemistry

# --- Monitoring (optional) ---------------------------------------------------
# A URL to GET on success — healthchecks.io, Better Uptime, or similar. A cron
# that quietly stops is worse than no cron, because you believe you're covered.
# Leave empty to skip.
HEALTHCHECK_URL=

# Warn if the newest backup is older than this many hours (used by --verify).
STALE_AFTER_HOURS=36
