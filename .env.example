DATABASE_URL="postgresql://chemistry:chemistry@localhost:5432/chemistry?schema=public"

SESSION_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""

APP_BASE_URL="http://localhost:3000"

# The first administrator. Set this before the first start of a new
# deployment — sign-in is invite-only, so without an org admin there is
# nobody who can invite anyone. It upserts on every start, so it is safe to
# leave in place, and re-running the seed is how you grant admin later.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""

# Resend's HTTP API for magic-link emails (not SMTP — cloud providers commonly
# block outbound SMTP ports by default; the HTTP API just needs port 443,
# which is already open for everything else). Leave unset in dev to log
# links to the console instead of sending mail.
RESEND_API_KEY=""
EMAIL_FROM="Chemistry <no-reply@chemistry.local>"

# S3 for work order photo attachments. Use an IAM user scoped to a single prefix
# in an existing bucket, e.g. policy resource "arn:aws:s3:::<bucket>/chemistry/*".
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PREFIX="chemistry"

# Email of the root Director: the only account that may grant or revoke the
# Director role. Leave unset and nobody can grant it.
ROOT_DIRECTOR_EMAIL=
